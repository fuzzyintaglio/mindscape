{
  "name": "mindscape",
  "version": "0.0.1",
  "private": true,
  "description": "Local-only kanban + daily notes + reference notes, with Claude-assisted intake.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "stop": "tsx cli/mindscape.ts stop",
    "setup": "tsx cli/mindscape.ts setup",
    "doctor": "tsx cli/mindscape.ts doctor",
    "check:workmac": "bash scripts/workmac-check.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
