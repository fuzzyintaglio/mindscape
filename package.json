{
  "name": "mindscape",
  "version": "0.0.1",
  "private": true,
  "description": "Local-only kanban + daily notes + reference notes, with Claude-assisted intake.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "release": "node scripts/release.mjs",
    "start": "tsx server/index.ts",
    "stop": "tsx cli/mindscape.ts stop",
    "setup": "tsx cli/mindscape.ts setup",
    "doctor": "tsx cli/mindscape.ts doctor",
    "check:workmac": "bash scripts/workmac-check.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@hono/node-server": "^1.13.7",
    "codemirror": "^6.0.2",
    "hono": "^4.6.14",
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
